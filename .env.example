PORT=3000
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
# Comma-separated browser origins. Required in production, for example:
# APP_ORIGINS=https://app.example.com,https://admin.example.com
APP_ORIGINS=http://localhost:3000
# Maximum requests per IP for all auth endpoints in each 15-minute window.
AUTH_RATE_LIMIT_MAX=10
# Required only if you want Supabase's password-reset email to redirect to a specific app/web URL.
PASSWORD_RESET_REDIRECT_URL=
