# Server
PORT=3000
NODE_ENV=development
# Comma-separated web origins. Leave empty to allow non-browser Flutter clients.
APP_ORIGINS=http://localhost:3000

# Firebase Admin (choose one approach)
# 1. Put a one-line JSON service-account value here (recommended for deployment):
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2. Or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional when using application default credentials
FIREBASE_PROJECT_ID=
